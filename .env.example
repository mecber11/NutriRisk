# NutriRisk AI — variables de entorno
# Copie este archivo como .env y ajuste los valores antes de desplegar.

# ----------------------------- Aplicación -----------------------------
APP_NAME=NutriRisk AI
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=cambie-esta-clave-por-una-aleatoria-de-64-caracteres-0123456789abcdef
TIMEZONE=UTC
DEMO_MODE=true
AUTO_SEED=false

# ------------------------------ Seguridad -----------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=10
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15
ANONYMIZATION_SALT=cambie-esta-sal-de-anonimizacion
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_LOGIN_PER_MINUTE=20
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# ---------------------------- Base de datos ---------------------------
POSTGRES_DB=nutririsk
POSTGRES_USER=nutririsk
POSTGRES_PASSWORD=nutririsk
DB_PORT=5432
# Para ejecución local sin Docker (modo demostración):
# DATABASE_URL=sqlite:///./data/nutririsk.db
DATABASE_URL=postgresql+psycopg://nutririsk:nutririsk@localhost:5432/nutririsk

# ------------------------------ Servicios -----------------------------
API_PORT=8000
WEB_PORT=8080
API_PUBLIC_URL=http://localhost:8000
N8N_PORT=5678
N8N_USER=admin
N8N_PASSWORD=nutririsk2026
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_TOKEN=nutririsk-n8n-token
LANGFLOW_PORT=7860
LANGFLOW_BASE_URL=http://localhost:7860

# --------------------------------- ML ---------------------------------
RANDOM_SEED=42
TEST_SIZE=0.2
CV_FOLDS=5
SEED_TRAIN=true
INSTALL_TORCH=true

# ---------------------------- Agente / LLM ----------------------------
# deterministic (sin clave) | openai
LLM_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------- Correo -------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertas@nutririsk.local
ALERT_EMAIL_TO=

# Investigación (opcionales; el estudio guarda resultados locales siempre)
MLFLOW_TRACKING_URI=
S3_ENDPOINT_URL=
S3_BUCKET=nutririsk
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MINIO_ROOT_USER=nutririsk-local
MINIO_ROOT_PASSWORD=
# n8n: configure credencial SMTP antes de activar WF-04
NUTRIRISK_ALERT_EMAIL=
NUTRIRISK_SMTP_FROM=
